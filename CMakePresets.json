{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ASRYX_BUILD_TESTS": "OFF",
        "ASRYX_BACKEND": "cpu"
      }
    },
    {
      "name": "release-cuda",
      "inherits": "release",
      "displayName": "Release CUDA",
      "cacheVariables": {
        "ASRYX_BACKEND": "cuda"
      }
    },
    {
      "name": "release-vulkan",
      "inherits": "release",
      "displayName": "Release Vulkan",
      "cacheVariables": {
        "ASRYX_BACKEND": "vulkan"
      }
    },
    {
      "name": "test",
      "inherits": "base",
      "displayName": "Test",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASRYX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASRYX_BUILD_TESTS": "ON",
        "ASRYX_SANITIZER": "address"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "displayName": "UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASRYX_BUILD_TESTS": "ON",
        "ASRYX_SANITIZER": "undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "release-cuda", "configurePreset": "release-cuda" },
    { "name": "release-vulkan", "configurePreset": "release-vulkan" },
    { "name": "test", "configurePreset": "test" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0"
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
