{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared configure shape for every project preset.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "CPU release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "BACKEND": "cpu"
      }
    },
    {
      "name": "release-cuda",
      "inherits": "release",
      "displayName": "Release CUDA",
      "description": "CUDA release build",
      "cacheVariables": {
        "BACKEND": "cuda"
      }
    },
    {
      "name": "release-vulkan",
      "inherits": "release",
      "displayName": "Release Vulkan",
      "description": "Vulkan release build",
      "cacheVariables": {
        "BACKEND": "vulkan"
      }
    },
    {
      "name": "test",
      "inherits": "base",
      "displayName": "Test",
      "description": "Dev test build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer",
      "description": "Dev AddressSanitizer test build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "SANITIZER": "address"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "displayName": "UndefinedBehaviorSanitizer",
      "description": "Dev UndefinedBehaviorSanitizer test build.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "SANITIZER": "undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "description": "Builds the configured CPU release binary."
    },
    {
      "name": "release-cuda",
      "configurePreset": "release-cuda",
      "description": "Builds the configured CUDA release binary."
    },
    {
      "name": "release-vulkan",
      "configurePreset": "release-vulkan",
      "description": "Builds the configured Vulkan release binary."
    },
    {
      "name": "test",
      "configurePreset": "test",
      "description": "Builds the dev test binary."
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "description": "Builds the AddressSanitizer test binary."
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "description": "Builds the UndefinedBehaviorSanitizer test binary."
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "description": "Runs the regular test suite.",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "description": "Runs the test suite with AddressSanitizer.",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0"
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "description": "Runs the test suite with UndefinedBehaviorSanitizer.",
      "output": { "outputOnFailure": true }
    }
  ]
}
