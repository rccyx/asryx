#!/usr/bin/env bash
set -Eeuo pipefail

ASRYX_PACKAGE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ASRYX_REPO_DIR="$(cd -- "${ASRYX_PACKAGE_DIR}/.." && pwd -P)"
ASRYX_LOG_PREFIX="asryx build"
ASRYX_COMMAND_NAME="./package/build"

# shellcheck source=package/lib/_shell.sh
source "${ASRYX_PACKAGE_DIR}/lib/_shell.sh"
# shellcheck source=package/lib/_constants.sh
source "${ASRYX_PACKAGE_DIR}/lib/_constants.sh"
# shellcheck source=package/lib/_options.sh
source "${ASRYX_PACKAGE_DIR}/lib/_options.sh"
# shellcheck source=package/lib/_requirements.sh
source "${ASRYX_PACKAGE_DIR}/lib/_requirements.sh"
# shellcheck source=package/lib/_dependencies.sh
source "${ASRYX_PACKAGE_DIR}/lib/_dependencies.sh"
# shellcheck source=package/lib/_build.sh
source "${ASRYX_PACKAGE_DIR}/lib/_build.sh"

export GIT_TERMINAL_PROMPT=0

main() {
  _asryx_parse_build_options "$@"
  _asryx_require_home
  _asryx_require_build_dependencies
  _asryx_require_backend_dependencies "${ASRYX_BACKEND}"
  _asryx_install_package_deps
  _asryx_build_package
}

main "$@"
