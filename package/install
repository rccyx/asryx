#!/usr/bin/env bash
set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_dir="$(cd -- "${script_dir}/.." && pwd -P)"

ASRYX_LOG_PREFIX="asryx install"
# shellcheck source=package//lib/_common.sh
source "${script_dir}/lib/_common.sh"
# shellcheck source=package//lib/_constants.sh
source "${script_dir}/lib/_constants.sh"
# shellcheck source=package//lib/_deps.sh
source "${script_dir}/lib/_deps.sh"

export GIT_TERMINAL_PROMPT=0

model_name="${ASRYX_DEFAULT_MODEL}"
backend="cpu"
install_dev=0
whisper_url="https://github.com/ggml-org/whisper.cpp.git"
whisper_dir="$(_asryx_home_path "${ASRYX_WHISPER_DIR_REL}")"
libassert_url="https://github.com/jeremy-rifkin/libassert.git"
libassert_dir="$(_asryx_home_path "${ASRYX_LIBASSERT_DIR_REL}")"

select_backend() {
  local requested="$1"

  if [[ "${backend}" != "cpu" && "${backend}" != "${requested}" ]]; then
    _asryx_die "CUDA and Vulkan backends cannot be selected together"
  fi

  backend="${requested}"
}

parse_args() {
  local arg=""

  for arg in "$@"; do
    case "${arg}" in
      --dev)
        install_dev=1
        ;;
      --cuda)
        select_backend "cuda"
        ;;
      --vulkan)
        select_backend "vulkan"
        ;;
      *) _asryx_die "unknown install option: ${arg}" ;;
    esac
  done
}

build_preset() {
  case "${backend}" in
    cpu)
      printf '%s\n' "release"
      ;;
    cuda)
      printf '%s\n' "release-cuda"
      ;;
    vulkan)
      printf '%s\n' "release-vulkan"
      ;;
    *)
      _asryx_die "internal error: unsupported backend ${backend}"
      ;;
  esac
}

read_whisper_sha() {
  local path="${repo_dir}/versions/whisper-cpp-sha"
  [[ -s "${path}" ]] || _asryx_die "missing whisper.cpp pin: ${path}"
  tr -d '[:space:]' <"${path}"
}

read_libassert_sha() {
  local path="${repo_dir}/versions/libassert-sha"
  [[ -s "${path}" ]] || _asryx_die "missing libassert pin: ${path}"
  tr -d '[:space:]' <"${path}"
}

sync_whisper_repo() {
  local whisper_sha="$1"

  [[ "${whisper_sha}" =~ ^[0-9a-f]{40}$ ]] ||
    _asryx_die "invalid whisper.cpp pin: ${whisper_sha}"

  _asryx_ensure_dir "$(_asryx_home_path "${ASRYX_DEPS_DIR_REL}")"

  if [[ -d "${whisper_dir}/.git" ]]; then
    _asryx_log "updating whisper.cpp"
    git -C "${whisper_dir}" remote set-url origin "${whisper_url}"
  else
    if [[ -e "${whisper_dir}" ]]; then
      _asryx_die "${whisper_dir} exists but is not a git checkout"
    fi

    _asryx_log "cloning whisper.cpp"
    git clone --no-checkout "${whisper_url}" "${whisper_dir}"
  fi

  git -C "${whisper_dir}" fetch --depth 1 origin "${whisper_sha}"
  git -C "${whisper_dir}" checkout --force --detach "${whisper_sha}"
  git -C "${whisper_dir}" reset --hard "${whisper_sha}"
  git -C "${whisper_dir}" submodule sync --recursive
  git -C "${whisper_dir}" submodule update --init --recursive

  local installed_sha=""
  installed_sha="$(git -C "${whisper_dir}" rev-parse HEAD)"
  [[ "${installed_sha}" == "${whisper_sha}" ]] ||
    _asryx_die "whisper.cpp checkout mismatch: expected ${whisper_sha}, got ${installed_sha}"

  git -C "${whisper_dir}" fsck --no-progress
}

sync_libassert_repo() {
  local libassert_sha="$1"

  _asryx_ensure_dir "$(_asryx_home_path "${ASRYX_DEPS_DIR_REL}")"

  if [[ -d "${libassert_dir}/.git" ]]; then
    _asryx_log "updating libassert"
    git -C "${libassert_dir}" fetch --depth 1 origin "${libassert_sha}"
  else
    if [[ -e "${libassert_dir}" ]]; then
      _asryx_die "${libassert_dir} exists but is not a git checkout"
    fi

    _asryx_log "cloning libassert"
    git clone "${libassert_url}" "${libassert_dir}"
    git -C "${libassert_dir}" fetch --depth 1 origin "${libassert_sha}"
  fi

  git -C "${libassert_dir}" checkout --detach "${libassert_sha}"
  git -C "${libassert_dir}" fsck --no-progress
}

install_libassert() {
  local libassert_sha="$1"
  local build_dir="${libassert_dir}/build/asryx-release"

  _asryx_log "configuring libassert"
  cmake -S "${libassert_dir}" -B "${build_dir}" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="${libassert_dir}/install" \
    -DLIBASSERT_BUILD_TESTING=OFF \
    -DLIBASSERT_USE_EXTERNAL_CPPTRACE=OFF

  _asryx_log "installing libassert"
  cmake --build "${build_dir}"
  cmake --install "${build_dir}"
  write_installed_libassert_pin "${libassert_sha}"
}

build_asryx() {
  local preset="$1"

  _asryx_log "configuring asryx (${backend})"
  cmake --fresh --preset "${preset}" -S "${repo_dir}"

  _asryx_log "building asryx (${backend})"
  cmake --build "${repo_dir}/build/${preset}" --target asryx
}

install_asryx_binary() {
  local preset="$1"
  local src_bin="${repo_dir}/build/${preset}/asryx"
  local dst_bin=""
  dst_bin="$(_asryx_home_path "${ASRYX_ASRYX_BIN_REL}")"

  [[ -x "${src_bin}" ]] || _asryx_die "missing built binary: ${src_bin}"
  _asryx_ensure_dir "$(_asryx_home_path "${ASRYX_LOCAL_BIN_DIR_REL}")"

  _asryx_log "installing ${dst_bin}"
  install -m 0755 "${src_bin}" "${dst_bin}"
}

write_installed_whisper_pin() {
  local whisper_sha="$1"
  local versions_dir
  versions_dir="$(dirname "$(_asryx_home_path "${ASRYX_WHISPER_PIN_REL}")")"
  local pin_path
  pin_path="$(_asryx_home_path "${ASRYX_WHISPER_PIN_REL}")"
  local tmp="${pin_path}.tmp.$$"

  _asryx_ensure_dir "${versions_dir}"
  printf '%s\n' "${whisper_sha}" >"${tmp}"
  mv -f "${tmp}" "${pin_path}"
}

write_installed_libassert_pin() {
  local libassert_sha="$1"
  local versions_dir
  versions_dir="$(dirname "$(_asryx_home_path "${ASRYX_LIBASSERT_PIN_REL}")")"
  local pin_path
  pin_path="$(_asryx_home_path "${ASRYX_LIBASSERT_PIN_REL}")"
  local tmp="${pin_path}.tmp.$$"

  _asryx_ensure_dir "${versions_dir}"
  printf '%s\n' "${libassert_sha}" >"${tmp}"
  mv -f "${tmp}" "${pin_path}"
}

write_default_config_if_missing() {
  local cfg
  cfg="$(_asryx_config_path)"
  [[ -e "${cfg}" ]] && return 0

  _asryx_log "writing ${cfg}"
  printf 'model=%s\nlanguage=%s\npipe_to=\n' "${model_name}" "${ASRYX_DEFAULT_LANGUAGE}" >"${cfg}"
}

install_vad_model() {
  local target
  target="$(_asryx_home_path "${ASRYX_MODELS_DIR_REL}")/${ASRYX_VAD_MODEL_FILE}"
  local tmp="${target}.tmp.$$"

  if [[ -s "${target}" ]]; then
    _asryx_log "VAD model already installed: ${target}"
    return 0
  fi

  _asryx_ensure_dir "$(_asryx_home_path "${ASRYX_MODELS_DIR_REL}")"
  _asryx_log "downloading VAD model ${ASRYX_VAD_MODEL_NAME}"

  if ! curl -fL --retry 3 -o "${tmp}" "${ASRYX_VAD_MODEL_URL}"; then
    rm -f -- "${tmp}"
    _asryx_die "failed to download VAD model"
  fi

  [[ -s "${tmp}" ]] || _asryx_die "downloaded VAD model is empty"
  mv -f "${tmp}" "${target}"
}


install_and_select_model() {
  local asryx_bin
  asryx_bin="$(_asryx_home_path "${ASRYX_ASRYX_BIN_REL}")"

  [[ -x "${asryx_bin}" ]] || _asryx_die "missing installed binary: ${asryx_bin}"
  "${asryx_bin}" --model install "${model_name}"
  "${asryx_bin}" --model use "${model_name}"
}

warn_path_if_needed() {
  local bin_dir
  bin_dir="$(_asryx_home_path "${ASRYX_LOCAL_BIN_DIR_REL}")"

  case ":${PATH}:" in
    *":${bin_dir}:"*) return 0 ;;
  esac

  _asryx_log "note: ${bin_dir} is not in PATH"
  _asryx_log "      add: export PATH=\"${bin_dir}:\$PATH\""
}

main() {
  parse_args "$@"
  _asryx_require_home

  _asryx_require_runtime_dependencies
  _asryx_require_backend_dependencies "${backend}"

  if [[ "${install_dev}" -eq 1 ]]; then
    _asryx_require_dev_dependencies
  fi

  local whisper_sha=""
  whisper_sha="$(read_whisper_sha)"
  _asryx_log "whisper.cpp pin: ${whisper_sha}"

  sync_whisper_repo "${whisper_sha}"

  if [[ "${install_dev}" -eq 1 ]]; then
    local libassert_sha=""
    libassert_sha="$(read_libassert_sha)"
    _asryx_log "libassert pin: ${libassert_sha}"
    sync_libassert_repo "${libassert_sha}"
    install_libassert "${libassert_sha}"
  fi

  local preset=""
  preset="$(build_preset)"

  build_asryx "${preset}"
  install_asryx_binary "${preset}"
  write_installed_whisper_pin "${whisper_sha}"
  write_default_config_if_missing
  install_vad_model
  install_and_select_model
  warn_path_if_needed
}

main "$@"
